# ------------------------------------------------------------------
# Mona Roses 2.0 – Umgebungsvariablen
# Kopieren nach .env.local (Entwicklung) bzw. im Deployment setzen.
# ------------------------------------------------------------------

# Öffentliche Basis-URL (für Metadaten, Sitemap, OG-Bilder)
NEXT_PUBLIC_SITE_URL=https://www.mona-roses.com

# ---- Datenquelle -------------------------------------------------
# mock   = fiktive Testdaten (Standard, solange die VyceON-API fehlt)
# vyceon = echte VyceON-API
DATA_SOURCE=mock

# ---- VyceON (Vyce69) ---------------------------------------------
# ANNAHME: Werte und Format werden mit dem VyceON-Team abgestimmt,
# siehe docs/vyceon-fragen.md
VYCEON_API_URL=https://api.vyceon.example/v1
VYCEON_API_KEY=
VYCEON_CLUB_ID=
# Gemeinsames Geheimnis für die HMAC-Signatur des Webhooks POST /api/revalidate
# (mind. 16 Zeichen, z. B. `openssl rand -hex 32`)
VYCEON_WEBHOOK_SECRET=
# Hostname, von dem VyceON Profilbilder ausliefert (für next/image, wird beim Build gesetzt)
VYCEON_IMAGE_HOST=

# ---- Bewerbungsformular (SMTP) -----------------------------------
SMTP_HOST=
SMTP_PORT=587
# true für Port 465 (TLS), sonst false (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mona Roses Website <noreply@mona-roses.com>"
# Empfänger der Bewerbungen
JOBS_MAIL_TO=
# Max. Bewerbungen pro IP und Stunde
RATE_LIMIT_PER_HOUR=5
# Hinter einem Reverse-Proxy (Coolify/Traefik) die Client-IP aus X-Forwarded-For lesen
TRUST_PROXY=true

# ---- Keystatic (Redaktionssystem) --------------------------------
# local  = Dateien direkt im Projekt (nur Entwicklung; Admin ist in Produktion aus)
# github = Änderungen als Commits ins Repo, danach automatisches Deployment
NEXT_PUBLIC_KEYSTATIC_STORAGE=local
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=owner/repo
# Nur im GitHub-Modus nötig (werden beim ersten Aufruf von /keystatic erzeugt)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
